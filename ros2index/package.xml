<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>ros2index</name>
  <version>0.0.0</version>
  <description>
    The index command for ROS 2 command line tools, for listing and inspecting entries in the
    ament resource index.
  </description>

  <maintainer email="thomas.ung@pal-robotics.com">Thomas Ung</maintainer>

  <license>Apache License 2.0</license>

  <author email="thomas.ung@pal-robotics.com">Thomas Ung</author>

  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>ros2cli</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
